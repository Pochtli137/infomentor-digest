# Kopiera denna fil till .env och fyll i. .env delas aldrig med någon.

# Mejl. Med Gmail: skapa ett app-lösenord på myaccount.google.com/apppasswords
# (vanligt lösenord fungerar inte om du har tvåstegsverifiering).
MAIL_ANVANDARE=dinadress@gmail.com
MAIL_LOSENORD=app-losenordet-har
MAIL_TILL=dinadress@gmail.com,partner@example.com

# Annan mejlleverantör än Gmail? Fyll i dessa också.
# SMTP_VARD=smtp.example.com
# SMTP_PORT=587

# Sammanfattningen. Har du Claude Code installerat behövs ingenting här.
# Annars: en nyckel från console.anthropic.com eller aistudio.google.com
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
